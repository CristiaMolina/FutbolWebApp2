37852>>>    Procedure SetActionButtons
37855>>>        tWebNavigateData NavigateData
37855>>>        tWebNavigateData NavigateData
37855>>>        Boolean bHasRecord
37855>>>        Handle hoDD
37855>>>
37855>>>        Get Server to hoDD
37856>>>        Get GetNavigateData to NavigateData
37857>>>        Get HasRecord of hoDD to bHasRecord
37858>>>
37858>>>        // let's hide all buttons and then Show the ones we want
37858>>>        WebSet pbRender of oEditBtn to False
37859>>>        WebSet pbRender of oSaveBtn to False
37860>>>        WebSet pbRender of oCancelChangesBtn to False
37861>>>        WebSet pbRender of oDeleteBtn to False
37862>>>
37862>>>        If (NavigateData.bReadOnly) Begin
37864>>>            WebSet pbRender of oEditBtn to True
37865>>>        End
37865>>>>
37865>>>        Else Begin
37866>>>            WebSet pbRender of oSaveBtn to True
37867>>>            WebSet pbRender of oCancelChangesBtn to True
37868>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37869>>>        End
37869>>>>
37869>>>    End_Procedure
