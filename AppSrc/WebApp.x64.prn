38664>>>    Procedure SetActionButtons
38667>>>        tWebNavigateData NavigateData
38667>>>        tWebNavigateData NavigateData
38667>>>        Boolean bHasRecord
38667>>>        Handle hoDD
38667>>>
38667>>>        Get Server to hoDD
38668>>>        Get GetNavigateData to NavigateData
38669>>>        Get HasRecord of hoDD to bHasRecord
38670>>>
38670>>>        // let's hide all buttons and then Show the ones we want
38670>>>        WebSet pbRender of oEditBtn to False
38671>>>        WebSet pbRender of oSaveBtn to False
38672>>>        WebSet pbRender of oCancelChangesBtn to False
38673>>>        WebSet pbRender of oDeleteBtn to False
38674>>>
38674>>>        If (NavigateData.bReadOnly) Begin
38676>>>            WebSet pbRender of oEditBtn to True
38677>>>        End
38677>>>>
38677>>>        Else Begin
38678>>>            WebSet pbRender of oSaveBtn to True
38679>>>            WebSet pbRender of oCancelChangesBtn to True
38680>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38681>>>        End
38681>>>>
38681>>>    End_Procedure
